Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 1
      Class: rviz_default_plugins/Image
      Enabled: true
      Topic: /reconfactory/vision/image_raw
      Max Value: 1
      Median window: 5
      Min Value: 0
      Name: Raw Vision Camera
      Normalize Range: true
      Transport Hint: raw
      Value: true
    - Alpha: 1
      Class: rviz_default_plugins/Image
      Enabled: true
      Topic: /reconfactory/vision/debug_image
      Max Value: 1
      Median window: 5
      Min Value: 0
      Name: Annotated Vision Result
      Normalize Range: true
      Transport Hint: raw
      Value: true
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: reconfactory_vision_camera_optical_frame
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
  Value: true
Window Geometry:
  Height: 900
  Width: 1200
