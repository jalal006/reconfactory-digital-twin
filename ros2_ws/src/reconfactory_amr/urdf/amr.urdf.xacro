<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="reconfactory_amr">
  <material name="steel"><color rgba="0.36 0.38 0.39 1"/></material>
  <material name="rubber"><color rgba="0.055 0.06 0.06 1"/></material>
  <link name="base_footprint"/>
  <joint name="base_joint" type="fixed"><parent link="base_footprint"/><child link="base_link"/><origin xyz="0 0 0.16"/></joint>
  <link name="base_link">
    <inertial><mass value="12"/><inertia ixx="0.16" iyy="0.22" izz="0.29" ixy="0" ixz="0" iyz="0"/></inertial>
    <visual><geometry><box size="0.42 0.30 0.16"/></geometry><material name="steel"/></visual>
    <visual name="payload_tray"><origin xyz="0 0 0.17"/><geometry><box size="0.42 0.42 0.02"/></geometry><material name="steel"/></visual>
    <visual name="tray_support"><origin xyz="-0.16 0 0.12"/><geometry><box size="0.04 0.10 0.08"/></geometry><material name="steel"/></visual>
    <collision><geometry><box size="0.42 0.30 0.16"/></geometry></collision>
  </link>
  <xacro:macro name="wheel" params="side y">
    <link name="${side}_wheel">
      <inertial><mass value="0.5"/><inertia ixx="0.0014" iyy="0.0025" izz="0.0014" ixy="0" ixz="0" iyz="0"/></inertial>
      <visual><origin rpy="1.5707963 0 0"/><geometry><cylinder radius="0.10" length="0.045"/></geometry><material name="rubber"/></visual>
      <collision><origin rpy="1.5707963 0 0"/><geometry><cylinder radius="0.10" length="0.045"/></geometry></collision>
    </link>
    <joint name="${side}_wheel_joint" type="continuous"><parent link="base_link"/><child link="${side}_wheel"/><origin xyz="0 ${y} -0.06"/><axis xyz="0 1 0"/><limit effort="10" velocity="8"/><dynamics damping="0.01"/></joint>
    <gazebo reference="${side}_wheel"><mu1>1.0</mu1><mu2>1.0</mu2></gazebo>
  </xacro:macro>
  <xacro:wheel side="left" y="0.1725"/><xacro:wheel side="right" y="-0.1725"/>
  <xacro:macro name="caster" params="name x">
    <link name="${name}"><inertial><mass value="0.1"/><inertia ixx="0.00004" iyy="0.00004" izz="0.00004" ixy="0" ixz="0" iyz="0"/></inertial>
      <visual><geometry><sphere radius="0.035"/></geometry><material name="rubber"/></visual>
      <collision><geometry><sphere radius="0.035"/></geometry></collision>
    </link>
    <joint name="${name}_joint" type="fixed"><parent link="base_link"/><child link="${name}"/><origin xyz="${x} 0 -0.125"/></joint>
    <gazebo reference="${name}"><mu1>0.001</mu1><mu2>0.001</mu2></gazebo>
  </xacro:macro>
  <xacro:caster name="front_caster" x="0.16"/><xacro:caster name="rear_caster" x="-0.16"/>
  <link name="laser_link"><inertial><mass value="0.1"/><inertia ixx="0.0001" iyy="0.0001" izz="0.0001" ixy="0" ixz="0" iyz="0"/></inertial>
    <visual><geometry><cylinder radius="0.035" length="0.04"/></geometry><material name="rubber"/></visual>
  </link>
  <joint name="laser_joint" type="fixed"><parent link="base_link"/><child link="laser_link"/><origin xyz="0.19 0 0.12"/></joint>
  <gazebo reference="laser_link">
    <sensor name="lidar" type="gpu_lidar"><topic>/amr/scan</topic><gz_frame_id>laser_link</gz_frame_id><update_rate>10</update_rate><always_on>true</always_on>
      <lidar><scan><horizontal><samples>360</samples><resolution>1</resolution><min_angle>-3.14159265</min_angle><max_angle>3.14159265</max_angle></horizontal></scan>
        <range><min>0.08</min><max>15.0</max><resolution>0.01</resolution></range>
      </lidar>
    </sensor>
  </gazebo>
  <gazebo>
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>left_wheel_joint</left_joint><right_joint>right_wheel_joint</right_joint>
      <wheel_separation>0.345</wheel_separation><wheel_radius>0.10</wheel_radius>
      <topic>/amr/cmd_vel</topic><odom_topic>/amr/odom</odom_topic><tf_topic>/amr/tf</tf_topic>
      <frame_id>odom</frame_id><child_frame_id>base_footprint</child_frame_id><odom_publish_frequency>30</odom_publish_frequency>
      <max_linear_velocity>0.55</max_linear_velocity><max_angular_velocity>1.0</max_angular_velocity>
      <max_linear_acceleration>0.7</max_linear_acceleration><max_angular_acceleration>1.0</max_angular_acceleration>
    </plugin>
    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <topic>/amr/joint_states</topic><joint_name>left_wheel_joint</joint_name><joint_name>right_wheel_joint</joint_name>
    </plugin>
  </gazebo>
</robot>
